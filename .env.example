# ---------------------------------------------------------------------------
# Apple Console — DEMO environment configuration (copy to `.env` to use).
# NEVER commit your real `.env` file. This example is tracked on purpose.
# ---------------------------------------------------------------------------

# Demo gate passcode (DEMO-ONLY access control — this is NOT authentication
# and deliberately NOT the original Android app's shared secret).
# Defaults to "demo-access" when unset.
VITE_DEMO_PASSWORD=change-me-demo

# Firebase (demo backend — Realtime Database only; writes happen ONLY via
# the explicit NEW GAME action, which publishes /m11 atomically).
#
# ONLY the database URL is required. The read-only /m11 mirror works with
# this file copied as-is: the RTDB connection does not use an API key and
# the demo database is publicly readable (Phase 4 verified this with an
# unauthenticated REST read). Every other value below is an optional
# passthrough used only when present.
#
# The existing DEMO Android client is hard-pinned to the URL below, so it
# must stay exactly as it is.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=zaem-a8d30.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://zaem-a8d30-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=zaem-a8d30
VITE_FIREBASE_STORAGE_BUCKET=zaem-a8d30.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
